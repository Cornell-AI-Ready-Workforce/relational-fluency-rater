# Copy to .env for local development. Every value here is optional locally.
# In production these come from the ECS task definition (infra/terraform/ecs.tf)
# and Secrets Manager; the image has no .env.

# Gates every researcher route. Empty is allowed only on a loopback bind; a
# public bind refuses to start without it.
RESEARCHER_KEY=

# Step 1, READ ONLY. Either a local copy of step 1's DATA_DIR (sessions/<id>/,
# runs/<run_id>.json) or the real bucket with your own AWS credentials. Unset:
# no step 1 data.
SOURCE_DIR=
# SOURCE_BUCKET=relational-fluency-study-data

# This app's records. Unset: written under DATA_DIR/rater-records/ (DATA_DIR
# defaults to ./data). Setting RATER_BUCKET writes to the production bucket.
# RATER_BUCKET=relational-fluency-rater-study-data
# DATA_DIR=

AWS_REGION=us-east-1

# Bind address and port. 8766 locally, so step 1 (8765) can run beside it.
HOST=127.0.0.1
PORT=8766

# Host-header allowlist; defaults to APP_HOST plus localhost and 127.0.0.1.
# APP_HOST=rater.ai-ready-workforce.ai.cornell.edu
# ALLOWED_HOSTS=

# /health active_sessions: participants seen within this many seconds.
# ACTIVE_WINDOW_SECONDS=1800
# How long the step 1 manifest index is cached, in seconds.
# SOURCE_INDEX_TTL_SECONDS=300
